{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Data/catalog.db"
  },
  "SeedUsers": {
    "Enabled": false
  },
  "Parser": {
    "ProductLimit": 20,
    "RequestTimeoutSeconds": 15,
    "MaxConcurrency": 4
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
