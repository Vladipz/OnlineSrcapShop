# Copy to .env (Git-ignored). Set strong, distinct account passwords locally.
# Demo values Admin123! / User123! are suitable ONLY for local evaluation.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
USER_EMAIL=user@example.com
USER_PASSWORD=
SEED_USERS_ENABLED=true
# Optional HTTPS override: absolute directory with fullchain.pem and privkey.pem.
# TLS_CERTIFICATE_DIR=C:/path/to/certificates
